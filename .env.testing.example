# Copy to .env.testing, which is gitignored, then fill in the blanks:
#
#   cp .env.testing.example .env.testing
#   php artisan key:generate --env=testing
#   php artisan jwt:secret --env=testing
#
# The test database must exist before the first run. RefreshDatabase migrates
# and truncates it, but it will not create it:
#
#   docker compose exec db \
#       psql -U dev -d postgres -c "CREATE DATABASE project_app_testing OWNER dev;"
#
# The database named here must appear in ALLOWED_TEST_DATABASES in
# tests/CreatesApplication.php, or the suite refuses to run.
#
# CI does not use this file. The workflow in .gitea/workflows supplies the same
# values as environment variables, which take precedence over any env file.

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

# DB_HOST is the docker-compose service name. Use 127.0.0.1 with the published
# port (5434) instead when running tests from the host rather than inside a
# container.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=project_app_testing
DB_USERNAME=dev
DB_PASSWORD=dev

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_FROM_NAME="${APP_NAME}"
MAIL_FROM_ADDRESS="mbarclay@zagmail.gonzaga.edu"

MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_DEFAULT_REGION=home
MINIO_BUCKET=home-dashboard
LOCAL_MINIO_ENDPOINT=http://10.5.10.11:9002
REMOTE_MINIO_ENDPOINT=https://minio.bigmike.dev

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# php artisan jwt:secret --env=testing
JWT_SECRET=
JWT_TTL=43200

PASSPHRASE=test
